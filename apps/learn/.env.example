# Copy to .env.production (gitignored) for `pnpm build:learn`. Values come from
#   firebase apps:sdkconfig WEB <appId> --project <projectId>
# Same project as teach; a separate "learn" web app is optional (teach's config works too).
# `pnpm dev:learn` ignores them and always uses the emulators (demo-lessonkaki).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
