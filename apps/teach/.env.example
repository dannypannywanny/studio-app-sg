# Copy to .env.production (gitignored) for `pnpm build:teach`. Values come from
#   firebase apps:sdkconfig WEB <appId> --project <projectId>
# These identify the project; they are not secrets, but they stay out of git so each
# environment (and later each school's deployment) keeps its own file.
# `pnpm dev:teach` ignores them and always uses the emulators (demo-lessonkaki).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
