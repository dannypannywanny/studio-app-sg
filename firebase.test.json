{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "src",
        "test",
        "scripts",
        "*.log",
        "tsconfig.json",
        "vitest.config.mts",
        "build.mjs"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9098
    },
    "firestore": {
      "port": 8180
    },
    "functions": {
      "port": 5002
    },
    "storage": {
      "port": 9198
    },
    "hub": {
      "port": 4402
    },
    "logging": {
      "port": 4502
    },
    "ui": {
      "enabled": true,
      "port": 4002
    },
    "singleProjectMode": true
  },
  "storage": {
    "rules": "storage.rules"
  }
}
